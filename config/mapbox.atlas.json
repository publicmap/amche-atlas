{
  "name": "Mapbox",
  "headerImage": "assets/map-layers/mapbox/map-layer-mapbox-streets.png",
  "icon": "https://upload.wikimedia.org/wikipedia/commons/1/1f/Mapbox_logo_2019.svg",
  "areaOfInterest": "Global",
  "description": "Global vector basemaps from Mapbox.com",
  "version": "0.1.0",
  "url": "https://github.com/publicmap/amche-goa/blob/main/config/goa.atlas.json",
  "color": "#2563eb",
  "bbox": [
    -180,
    -90,
    180,
    90
  ],
  "map": {
    "style": "mapbox://styles/mapbox/standard"
  },
  "layers": [
    {
      "id": "traffic",
      "tags": [
        "traffic"
      ],
      "title": "Traffic",
      "description": "Live traffic map via <a href='https://docs.mapbox.com/data/tilesets/reference/mapbox-traffic-v1/' target='_blank'>Mapbox Traffic</a> vector tiles. Updated every 10 minutes.",
      "type": "style",
      "headerImage": "assets/map-layers/mapbox/map-layer-traffic.png",
      "layers": [
        {
          "title": "Traffic",
          "sourceLayer": "traffic"
        }
      ]
    },
    {
      "id": "admin-lines",
      "tags": [
        "boundaries"
      ],
      "title": "Administrative Boundary Lines",
      "description": "Administrative boundary lines (admin-0/1/2) from Mapbox. See <a href='https://docs.mapbox.com/data/tilesets/reference/mapbox-streets-v8/#admin' target='_blank'>Mapbox Streets v8 Docs</a> for details.",
      "type": "vector",
      "attribution": "<a href='https://www.mapbox.com/boundaries'>© Mapbox Boundaries</a>",
      "url": "mapbox://mapbox.mapbox-streets-v8",
      "sourceLayer": "admin",
      "style": {
        "overlay/line-color": "white",
        "overlay/line-width": 1,
        "overlay/line-dasharray": [
          1,
          3,
          1
        ],
        "line-color": "purple",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          [
            "match",
            [
              "get",
              "admin_level"
            ],
            0,
            2.5,
            1,
            1,
            2,
            0.8,
            0.2
          ],
          15,
          [
            "match",
            [
              "get",
              "admin_level"
            ],
            0,
            12,
            1,
            8,
            2,
            4,
            2
          ]
        ],
        "line-opacity": 0.5
      },
      "inspect": false,
      "initiallyChecked": true
    },
    {
      "id": "countries",
      "tags": [
        "basemap"
      ],
      "title": "Mapbox Country Boundaries",
      "description": "Admin-0 level boundaries from Mapbox. See <a href='https://docs.mapbox.com/data/tilesets/reference/mapbox-countries-v1/' target='_blank'>Mapbox Countries v1 Docs</a> for details.",
      "type": "vector",
      "attribution": "<a href='https://www.mapbox.com/boundaries'>© Mapbox Boundaries</a>",
      "url": "mapbox://mapbox.country-boundaries-v1",
      "sourceLayer": "country_boundaries",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "disputed"
          ],
          "false"
        ],
        [
          "any",
          [
            "==",
            "all",
            [
              "get",
              "worldview"
            ]
          ],
          [
            "in",
            "IN",
            [
              "get",
              "worldview"
            ]
          ]
        ]
      ],
      "style": {
        "fill-color": "rgba(255, 255, 255, 0.2)"
      },
      "inspect": {
        "id": "iso_3166_1",
        "title": "Country",
        "label": "name_en"
      },
      "initiallyChecked": true
    },
    {
      "initiallyChecked": true,
      "id": "streets",
      "tags": [
        "basemap"
      ],
      "title": "Mapbox Street Map",
      "description": "Detailed street level map data layers sourced from <a href='https://www.openstreetmap.org/#map=11/15.4054/73.9280' target='_blank'>OpenStreetMap contributors</a> and other data sources via <a href='https://docs.mapbox.com/data/tilesets/reference/mapbox-streets-v8/' target='_blank'>Mapbox Streets</a> vector tiles.",
      "type": "style",
      "headerImage": "assets/map-layers/mapbox/map-layer-mapbox-streets.png",
      "attribution": "<a href='https://www.mapbox.com/about/maps' rel='noopener nofollow'>© Mapbox</a> <a href='https://www.openstreetmap.org/#map=16/15.49493/73.82864'>© OpenStreetMap contributors</a>",
      "layers": [
        {
          "title": "Hillshade",
          "sourceLayer": "hillshade"
        },
        {
          "title": "Address",
          "sourceLayer": "housenum_label"
        },
        {
          "title": "Places Labels",
          "sourceLayer": "place_label"
        },
        {
          "title": "Natural Labels",
          "sourceLayer": "natural_label"
        },
        {
          "title": "Airport Labels",
          "sourceLayer": "airport_label"
        },
        {
          "title": "Transit Labels",
          "sourceLayer": "transit_stop_label"
        },
        {
          "title": "Landmark Labels",
          "sourceLayer": "poi_label"
        },
        {
          "title": "Buildings",
          "sourceLayer": "building"
        },
        {
          "title": "Structures",
          "sourceLayer": "structure"
        },
        {
          "title": "Roads & Railways",
          "sourceLayer": "road",
          "initiallyChecked": false
        },
        {
          "title": "Runways",
          "sourceLayer": "aeroway"
        },
        {
          "title": "Hillshading",
          "sourceLayer": "hillshade"
        },
        {
          "title": "Landcover",
          "sourceLayer": "landcover"
        },
        {
          "title": "Landuse",
          "sourceLayer": "landuse"
        },
        {
          "title": "Wetlands & National Parks",
          "sourceLayer": "landuse_overlay"
        },
        {
          "title": "Waterways",
          "sourceLayer": "waterway"
        },
        {
          "title": "Waterbodies",
          "sourceLayer": "water"
        },
        {
          "title": "Boundaries",
          "sourceLayer": "admin"
        },
        {
          "title": "Country Boundaries",
          "sourceLayer": "country_boundaries"
        },
        {
          "title": "Bathymetry",
          "sourceLayer": "depth"
        },
        {
          "title": "Satellite",
          "sourceLayer": "satellite"
        }
      ]
    },
    {
      "id": "3d-buildings",
      "tags": [
        "buildings"
      ],
      "type": "vector",
      "title": "3D Buildings",
      "description": "Building footprints extruded to their mapped height, from the <a href='https://docs.mapbox.com/data/tilesets/reference/mapbox-streets-v8/#building' target='_blank'>Mapbox Streets v8 building layer</a>. Only footprints flagged <code>extrude</code> are drawn, from zoom 15; heights come from OpenStreetMap <code>height</code>/<code>min_height</code> tags where surveyed and are estimated from floor counts otherwise. Faces are shaded from light to dark with height, so taller massing reads at a glance.",
      "attribution": "<a href='https://www.mapbox.com/about/maps' rel='noopener nofollow'>© Mapbox</a> <a href='https://www.openstreetmap.org/#map=16/15.49493/73.82864'>© OpenStreetMap contributors</a>",
      "url": "mapbox://mapbox.mapbox-streets-v8",
      "sourceLayer": "building",
      "minzoom": 15,
      "filter": [
        "==",
        [
          "get",
          "extrude"
        ],
        "true"
      ],
      "style": {
        "fill-extrusion-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "number",
            [
              "get",
              "height"
            ],
            0
          ],
          0,
          "#eceff3",
          10,
          "#dbe0e7",
          30,
          "#bfc7d2",
          75,
          "#9aa5b5",
          150,
          "#77839a"
        ],
        "fill-extrusion-height": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          0,
          15.05,
          [
            "number",
            [
              "get",
              "height"
            ],
            0
          ]
        ],
        "fill-extrusion-base": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          0,
          15.05,
          [
            "number",
            [
              "get",
              "min_height"
            ],
            0
          ]
        ],
        "fill-extrusion-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          0.6,
          16.5,
          0.92
        ],
        "fill-extrusion-vertical-gradient": true,
        "line-color": [
          "case",
          [
            "boolean",
            [
              "feature-state",
              "selected"
            ],
            false
          ],
          "#ffcc4d",
          [
            "boolean",
            [
              "feature-state",
              "hover"
            ],
            false
          ],
          "#ffcc4d",
          "#54617a"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          15,
          0.4,
          18,
          1.2
        ],
        "line-opacity": [
          "case",
          [
            "boolean",
            [
              "feature-state",
              "selected"
            ],
            false
          ],
          1,
          [
            "boolean",
            [
              "feature-state",
              "hover"
            ],
            false
          ],
          0.9,
          0.35
        ]
      },
      "inspect": {
        "id": "height",
        "title": "Building",
        "label": "type",
        "fields": [
          "type",
          "height",
          "min_height",
          "underground"
        ],
        "fieldTitles": [
          "Type",
          "Height (m)",
          "Base height (m)",
          "Underground"
        ]
      }
    },
    {
      "initiallyChecked": true,
      "id": "terrain-v2",
      "tags": [
        "terrain"
      ],
      "type": "vector",
      "title": "Mapbox Terrain Contours",
      "sourceLayer": "contour",
      "description": "Elevation contour lines from <a href='https://docs.mapbox.com/data/tilesets/reference/mapbox-terrain-v2/' target='_blank'>Mapbox Terrain v2</a>. Index contours (every 5th and 10th line) are drawn heavier and carry the elevation label in metres; intermediate contours are lighter.",
      "attribution": "<a href='https://www.mapbox.com/about/maps' rel='noopener nofollow'>© Mapbox</a> <a href='https://www.maxar.com/' rel='noopener nofollow'>© Maxar</a>",
      "url": "mapbox://mapbox.mapbox-terrain-v2",
      "style": {
        "overlay/line-color": [
          "case",
          [
            "boolean",
            [
              "feature-state",
              "selected"
            ],
            false
          ],
          "#ffcc4d",
          [
            "boolean",
            [
              "feature-state",
              "hover"
            ],
            false
          ],
          "#ffcc4d",
          [
            "has",
            "index"
          ],
          "rgba(138, 90, 43, 0.95)",
          "rgba(163, 124, 84, 0.72)"
        ],
        "overlay/line-width": 0.5,
        "line-color": "rgba(255, 255, 255, 0.38)",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          [
            "case",
            [
              "has",
              "index"
            ],
            2.2,
            1.4
          ],
          17,
          [
            "case",
            [
              "has",
              "index"
            ],
            3.6,
            2.2
          ]
        ],
        "symbol-placement": "line",
        "symbol-spacing": 300,
        "text-field": [
          "case",
          [
            "has",
            "index"
          ],
          [
            "concat",
            [
              "to-string",
              [
                "get",
                "ele"
              ]
            ],
            " m"
          ],
          ""
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          9,
          17,
          11
        ],
        "text-padding": 6,
        "text-color": "#6b4423",
        "text-halo-color": "rgba(255, 255, 255, 0.9)",
        "text-halo-width": 1.4
      },
      "inspect": {
        "id": "ele",
        "title": "Elevation",
        "label": "ele"
      }
    },
    {
      "initiallyChecked": true,
      "id": "satellite",
      "tags": [
        "basemap",
        "satellite"
      ],
      "type": "tms",
      "title": "Satellite Imagery",
      "description": "Satellite imagery from Mapbox. See <a href='https://docs.mapbox.com/help/dive-deeper/imagery/'>Mapbox Satellite Imagery</a> for details.",
      "headerImage": "assets/map-layers/mapbox/map-layer-satellite.png",
      "attribution": "<a href='https://www.mapbox.com/about/maps' rel='noopener nofollow'>© Mapbox</a> <a href='https://www.maxar.com/' rel='noopener nofollow'>© Maxar</a>",
      "url": "mapbox://mapbox.satellite",
      "maxzoom": 22,
      "style": {
        "raster-opacity": 1
      }
    }
  ]
}