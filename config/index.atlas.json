            "zoom"
          ],
          "",
          12,
          [
            "to-string",
            [
              "get",
              "title"
            ]
          ]
        ],
        "title/text-size": 12,
        "title/text-offset": [
          0,
          -1.1
        ],
        "title/text-max-width": 30,
        "title/text-allow-overlap": true,
        "title/text-color": "#0b4f7a",
        "title/text-halo-color": "#ffffff",
